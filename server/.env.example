# Copy to .env for local overrides, or set these directly in Render's
# environment variable UI when deploying. Both are optional for local dev -
# with neither set, server/db.js falls back to a local file (server/aretete.db).

# From turso.tech after creating a database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render sets this automatically; only needed here for local testing against
# a non-default port.
PORT=8791
